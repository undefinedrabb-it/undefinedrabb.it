---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Trans Right Are Human Right!" description="Trans Right Are Human Right!">
  <div class="t flex flex-col gap-1">
    <div class="nb mt-2 flex h-[80vh] items-center justify-center rounded-3xl lg:h-[85vh] lg:w-[85vw] lg:rounded-[5rem]">
      <span class="text-center text-3xl text-black lg:text-9xl">
        Nonbinary Rights <br /> Are <br /> Human Rights!
      </span>
    </div>
    <div class="grow"></div>
    <div class="flex justify-center">
      <div class="pb-2">
        thanks to
        <a href="https://alvaromontoro.com/blog/68009/lgbtq-flags-coded-in-css">Alvaro Montoro</a>
        for blog post about flags in css
      </div>
    </div>
  </div>
</Layout>

<style>
  @supports (-webkit-touch-callout: none) {
    .t {
      height: -webkit-fill-available;
      width: -webkit-fill-available;
    }
  }

  .nb {
    background: linear-gradient(#fcf434 25%, #fcfcfc 0 50%, #9c59d1 0 75%, #2c2c2c 0 100%);
  }
</style>
