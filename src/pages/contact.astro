    <a class="u-url link" href="https://undefinedrabb.it">
      undefinedastrorabbit@gmail.com
    </a>
    <a class="u-url link" href="https://undefinedrabb.it">
      undefinedrabb.it
    </a>
    <a class="u-url link" href="https://github.com/undefinedrabb-it/" rel="me">
      github.com/undefinedrabb-it
    </a>
    {twtContact && (
      <a class="u-url link" href="https://twitter.com/u7drabbit" rel="me">
